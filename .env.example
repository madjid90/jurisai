# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# --- Frontend (Vite, exposed to browser) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# --- Server-side only (TanStack server functions) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
# Service role key — BYPASSES RLS. Server-only. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- AI / LLM Gateway ---
# Clé API OpenAI (ou compatible). Cherche OPENAI_API_KEY en priorité.
OPENAI_API_KEY="sk-your-openai-api-key"
# URL de base (défaut: https://api.openai.com/v1). Override si proxy custom.
# OPENAI_BASE_URL="https://api.openai.com/v1"

# --- Sécurité CRON ---
# Secret pour authentifier les appels CRON (veille juridique, barèmes, etc.)
CRON_SECRET="your-random-secret-min-32-chars"

# --- Notifications (optionnel) ---
# SLACK_API_KEY="xoxb-your-slack-bot-token"

# --- Observabilité (optionnel) ---
# Sentry DSN format : https://<key>@<host>/<project_id>
# Si défini, les erreurs server (severity=error|critical) et client (ErrorBoundary)
# sont push automatiquement à Sentry via HTTP (pas de SDK npm).
# SENTRY_DSN="https://your-key@your-org.ingest.sentry.io/your-project"
# VITE_SENTRY_DSN="https://your-key@your-org.ingest.sentry.io/your-project"
# SENTRY_RELEASE="jurisai@1.0.0"
# VITE_SENTRY_RELEASE="jurisai@1.0.0"
